<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>ModProfiler</RootNamespace>
    <AssemblyName>maschine-ModProfiler</AssemblyName>
    <Company>https://github.com/maschine34675/ModProfiler</Company>
    <Nullable>disable</Nullable>
    <Authors>maschine</Authors>
    <AssemblyVersion>1.4.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Version>$(AssemblyVersion)</Version>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <!-- This project sits in the repository root and would compile every
       subfolder with it. The tests are a project of their own that links the
       two Unity-free source files it covers (tests\ModProfiler.Tests); it
       must never reference this one, or running the tests would build the
       plugin and deploy it. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\..\BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <!-- Only for the game's own show-the-cursor event: setting Cursor.visible
         directly is what makes the game's per-frame check disagree, and the
         two then alternate at frame rate. See UI/CursorRequestNode.cs. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- EFT.InputSystem.InputNode derives from a Sirenix SerializedMonoBehaviour. -->
    <Reference Include="Sirenix.Serialization">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Singleton<GameWorld> tells a raid from the menu and the hideout for
         the EFT (vanilla) no-calls check. -->
    <Reference Include="Comfort">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll</HintPath>
    </Reference>
    <!-- Soft dependency: compile-time only, resolved through UI\WebOverlayGate
         at runtime. Never ship this DLL in the release zip. -->
    <Reference Include="Anvil-WebOverlay">
      <HintPath>..\..\BepInEx\plugins\Anvil-WebOverlay\Anvil-WebOverlay.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="web\profiler.html">
      <LogicalName>ModProfiler.profiler.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="DeployToPlugins" AfterTargets="PostBuildEvent" Condition="'$(SkipDeploy)'!='true'">
    <MakeDir Directories="$(ProjectDir)..\..\BepInEx\plugins\maschine-ModProfiler" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)..\..\BepInEx\plugins\maschine-ModProfiler" />
  </Target>

  <!--
    Release builds also produce the distributable zip next to the project:
    maschine-ModProfiler-<version>.zip with the BepInEx/plugins/... layout
    (extracts over the game root).
  -->
  <Target Name="CreateReleaseZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageRoot>$(ProjectDir)obj\package\</PackageRoot>
      <PackagePluginDir>$(PackageRoot)BepInEx\plugins\maschine-ModProfiler\</PackagePluginDir>
      <ReleaseZipPath>$(ProjectDir)maschine-ModProfiler-$(AssemblyVersion).zip</ReleaseZipPath>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageRoot)" />
    <MakeDir Directories="$(PackagePluginDir)" />
    <!-- Everything inside the plugin folder: a blind extraction must leave
         nothing in the game root. -->
    <Copy SourceFiles="$(TargetPath);$(ProjectDir)LICENSE;$(ProjectDir)README.md"
          DestinationFolder="$(PackagePluginDir)" />
    <Delete Files="$(ReleaseZipPath)" />
    <ZipDirectory SourceDirectory="$(PackageRoot)" DestinationFile="$(ReleaseZipPath)" />
    <Message Importance="high" Text="Release package created: $(ReleaseZipPath)" />
  </Target>
</Project>
